DB_CONTAINER_NAME = riwi-cine-db
POSTGRES_USER = nodejs
POSTGRES_PASSWORD = change_me
POSTGRES_DB = postgres
POSTGRES_PORT = 5432
# Nombre del servicio de la base de datos en docker-compose. No usar localhost.
POSTGRES_HOST = db

APP_CONTAINER_NAME = riwi-cine-backend
APP_PORT = 3000

DB_CPU_LIMIT = 2
DB_MEM_LIMIT = 512MB

APP_CPU_LIMIT = 2
APP_MEM_LIMIT = 512MB

NODE_ENV = development

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,https://midominio.com,https://www.midominio.com

# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_hex_64
JWT_REFRESH_SECRET=replace_with_another_random_hex_64

# Clave de prueba pública de Cloudflare Turnstile (siempre valida). Usa la clave real en producción.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

SEAT_LOCK_TTL_MINUTES=10
MAX_TICKETS_PER_SHOWTIME=5


# ============================================================
# GIT
# ============================================================

# Jenkins usa checkout scm desde el repositorio configurado en el job.
GIT_REPOSITORY=
GIT_BRANCH=main


# ============================================================
# JENKINS
# ============================================================

JENKINS_IMAGE=jenkins-example:latest

JENKINS_HOME=/var/jenkins_home

JENKINS_HTTP_PORT=8080

JENKINS_AGENT_PORT=50000
JENKINS_CPU_LIMIT=2.0
JENKINS_MEM_LIMIT=2560MB
SONAR_NODE_MAXSPACE=1024

# ============================================================
# SONARQUBE
# ============================================================

SONARQUBE_PORT=9000
SONARQUBE_ADMIN_USERNAME=admin
SONARQUBE_ADMIN_PASSWORD=admin
# Token generado en SonarQube (Mi cuenta > Seguridad). Solo para análisis local.
SONAR_TOKEN=replace_with_sonarqube_token

# ============================================================
# APPLICATION
# ============================================================

APP_IMAGE=cine-backend:latest

# production: servidor con SSH y PM2 que recibe los despliegues de Jenkins. Requiere SSH_PUBLIC_KEY.
APP_BUILD_TARGET=production

APP_HEALTH_PATH=/health

APP_DEPLOY_PATH=/opt/cine-backend


# ============================================================
# APPLICATION USER
# ============================================================

APP_USER=deploy
APP_UID=1000
APP_GID=1000


# ============================================================
# SSH
# ============================================================

SSH_HOST=app

SSH_PORT=22

SSH_CREDENTIAL_ID=cine-backend-deploy-ssh


# ============================================================
# PM2
# ============================================================

PM2_APP_NAME=cine-backend
SSH_PUBLIC_KEY=
