DB_CONTAINER_NAME = riwi-cine-db
POSTGRES_USER = nodejs
POSTGRES_PASSWORD = 123456
POSTGRES_DB = postgres
POSTGRES_PORT = 5432

APP_CONTAINER_NAME = riwi-cine-backend
APP_PORT = 3000

DB_CPU_LIMIT = 2
DB_MEM_LIMIT = 512MB

APP_CPU_LIMIT = 2
APP_MEM_LIMIT = 512MB

NODE_ENV = development

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,https://midominio.com,https://www.midominio.com

JWT_ACCESS_SECRET=a6675b6856d595d5949e03eecae59178449b83cb6ab620cc6cbb2619e440997b
JWT_REFRESH_SECRET=e80676a22713e9fbbb264afc7c833e76f11d42a6bf25a6c696461c4492e4cf25

TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

SEAT_LOCK_TTL_MINUTES=10
MAX_TICKETS_PER_SHOWTIME=5


# ============================================================
# GIT
# ============================================================

# Jenkins usa checkout scm desde el repositorio configurado en el job.
GIT_REPOSITORY=
GIT_BRANCH=main


# ============================================================
# JENKINS
# ============================================================

JENKINS_IMAGE=jenkins-example:latest

JENKINS_HOME=/var/jenkins_home

JENKINS_HTTP_PORT=8080

JENKINS_AGENT_PORT=50000

# ============================================================
# SONARQUBE
# ============================================================

SONARQUBE_PORT=9000

# ============================================================
# APPLICATION
# ============================================================

APP_CONTAINER_NAME=cine-backend

APP_IMAGE=cine-backend:latest

# Usa dev localmente; cambia a production para aceptar despliegues SSH de Jenkins.
APP_BUILD_TARGET=dev

APP_PORT=3000

APP_HEALTH_PATH=/health

APP_DEPLOY_PATH=/opt/cine-backend


# ============================================================
# APPLICATION USER
# ============================================================

APP_USER=deploy
APP_UID=1000
APP_GID=1000


# ============================================================
# SSH
# ============================================================

SSH_HOST=app

SSH_PORT=22

SSH_CREDENTIAL_ID=cine-backend-deploy-ssh


# ============================================================
# PM2
# ============================================================

PM2_APP_NAME=cine-backend
SSH_PUBLIC_KEY=
